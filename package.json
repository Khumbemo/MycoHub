{
  "name": "mycohub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-mycohub \"vitest run --config vitest.rules.config.js\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-mycohub",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "set-role": "node scripts/set-role.mjs",
    "deploy:functions": "npm --prefix functions install && firebase deploy --only functions",
    "test:functions": "firebase emulators:exec --only firestore,auth,functions --project demo-mycohub \"vitest run --config vitest.functions.config.js\"",
    "test:sync": "firebase emulators:exec --only auth,firestore,storage --project demo-mycohub \"vitest run --config vitest.sync.config.js\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "chart.js": "^4.4.2",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "firebase": "^11.10.0",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.1",
    "globals": "^17.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}