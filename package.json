{
  "name": "mycohub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && node scripts/build-standalone.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-mycohub \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "emulators": "firebase emulators:start --project demo-mycohub",
    "deploy:rules": "firebase deploy --only firestore:rules,storage",
    "set-role": "node scripts/set-role.mjs",
    "deploy:functions": "npm --prefix functions install && firebase deploy --only functions",
    "test:functions": "firebase emulators:exec --only firestore,auth,functions --project demo-mycohub \"vitest run --config vitest.functions.config.ts\"",
    "test:sync": "firebase emulators:exec --only auth,firestore,storage --project demo-mycohub \"vitest run --config vitest.sync.config.ts\""
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.1.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.1.1",
    "@capacitor/core": "^6.1.1",
    "@capacitor/geolocation": "^6.1.1",
    "chart.js": "^4.4.2",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "dexie": "^4.4.2",
    "firebase": "^10.14.1",
    "framer-motion": "^12.38.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.441.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "tailwind-merge": "^2.2.1",
    "vite-plugin-pwa": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.12.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.32.1",
    "globals": "^17.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.2.2",
    "vitest": "^3.2.7"
  }
}
