# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app.
# Firebase web config is public by design; security comes from firestore.rules / storage.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mycohub-mutha.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mycohub-mutha
VITE_FIREBASE_STORAGE_BUCKET=mycohub-mutha.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=148895400211
# Must be the *Web* app ID (1:...:web:...), not the Android one.
VITE_FIREBASE_APP_ID=

# Set to true to use local emulators (npm run emulators)
VITE_USE_EMULATORS=false
